# Secrets das Edge Functions — copie para .env.functions (ignorado pelo git)
# e aplique com: supabase secrets set --env-file .env.functions

# Obrigatória: base64 de 32 bytes. Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Trocar esta chave inviabiliza credenciais já cifradas (não há re-cifragem na V1).
PRIME_ENCRYPTION_KEY=

# URL pública da loja (usada para montar o link /entrega/<token>)
STORE_URL=http://localhost:5173

# Mercado Pago (sandbox). Sem MP_ACCESS_TOKEN o checkout responde 503.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=
