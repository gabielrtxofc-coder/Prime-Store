# Secrets das Edge Functions — copie para .env.functions (ignorado pelo git)
# e aplique com: supabase secrets set --env-file .env.functions

# Obrigatória: base64 de 32 bytes. Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Trocar esta chave inviabiliza credenciais já cifradas (não há re-cifragem na V1).
PRIME_ENCRYPTION_KEY=

# URL pública da loja (usada para montar o link /entrega/<token>)
STORE_URL=http://localhost:5173

# Origens autorizadas a chamar as Edge Functions (lista separada por vírgula).
# Não existe mais Access-Control-Allow-Origin: *. Sem a origem correta aqui o
# navegador bloqueia a resposta. STORE_URL é somada automaticamente.
# Inclua o domínio de produção, o "www" (se houver) e os endereços de
# desenvolvimento/preview usados pela equipe.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Mercado Pago (sandbox) — caminho legado CONGELADO. Só é usado quando
# WYVI_API_KEY não estiver definida (compatibilidade com ambientes antigos).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=

# WyviPay (API v2) — provedor ATIVO de cobrança PIX.
# A chave vem do painel WyviPay. A rotação é semanal (segundas): ao trocar,
# atualize AQUI e aplique de novo com `supabase secrets set --env-file
# .env.functions` — nunca commite a chave real nem a imprima em log.
# Sem WYVI_API_KEY o checkout responde 503 payment_not_configured (ou registra
# a solicitação sem pagamento quando o cliente envia fallback_to_request).
WYVI_API_KEY=
# Segredo do destino de webhook (`whsec_...`), exibido UMA única vez na criação
# do destino na WyviPay — guarde-o no cofre da equipe. Sem este segredo a
# função wyvi-webhook responde 503 fail-closed e NÃO processa nenhuma entrega.
WYVI_WEBHOOK_SECRET=
# Opcional: test | production. Quando ausente, é derivado do prefixo da chave
# (wy_test_ → test, wy_live_ → production). Em produção, eventos com
# dados.teste=true são ignorados.
WYVI_ENVIRONMENT=
# Base da API v2 (raramente muda; padrão já é o oficial).
# WYVI_API_BASE=https://api.wyvipay.com.br
