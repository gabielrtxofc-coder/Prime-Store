# ---------------------------------------------------------------------------
# Frontend (Vite) — variáveis embutidas no bundle, portanto SOMENTE valores
# públicos. Nunca coloque service_role/secret key aqui.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=chave-anon-publica
# Base das Edge Functions (default: ${VITE_SUPABASE_URL}/functions/v1)
VITE_BACKEND_URL=
# Quando "false", o catálogo usa apenas os dados locais de demonstração.
VITE_BACKEND_ENABLED=true
# Painel administrativo demonstrativo (dados fictícios em memória, sem rede).
# Só ligue onde não houver conta administrativa real. Nunca em produção.
VITE_ADMIN_DEMO=false

# ---------------------------------------------------------------------------
# Edge Functions (secrets do Supabase — `supabase secrets set --env-file`)
# ---------------------------------------------------------------------------
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetadas pelo runtime.
# MP_ACCESS_TOKEN=TEST-... (ausente = checkout responde 503 payment_not_configured)
# MP_WEBHOOK_SECRET=...
# MP_NOTIFICATION_URL=https://SEU-PROJETO.supabase.co/functions/v1/mp-webhook
# PRIME_ENCRYPTION_KEY=base64-de-32-bytes (obrigatória para estoque/entrega)
# STORE_URL=https://sua-loja.example
# --- Modo de pagamento demonstrativo (SOMENTE sandbox) ---------------------
# Liga a Edge Function `demo-payment`. Precisa das TRÊS travas:
#   1) este segredo = true
#   2) DEMO_ALLOWED_PROJECT_REFS com a ref do projeto
#   3) app_settings.demo_payments_enabled = true (scripts/enable-demo-mode.sql)
# Sem qualquer uma delas a função responde 404. Nunca configure em produção.
# DEMO_PAYMENT_ENABLED=false
# DEMO_ALLOWED_PROJECT_REFS=ref-do-projeto-sandbox
